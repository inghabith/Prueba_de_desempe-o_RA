# Variables de entorno del proyecto.
# docker-compose lee este archivo automáticamente. Si necesitas otros valores,
# crea un archivo .env con las mismas variables: sus valores reemplazan a estos.
# El archivo .env está excluido de git (.gitignore).

# Credenciales de las dos bases PostgreSQL (metadatos de Airflow y repositorio analítico).
# Son dos servidores separados; cada uno crea su propia base con este usuario.
POSTGRES_USER=datamart
POSTGRES_PASSWORD=datamart_pass

# Cadena de conexión de Airflow a su base de metadatos.
# Si cambias el usuario o la contraseña de arriba, cámbialos también aquí.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://datamart:datamart_pass@postgres-airflow:5432/airflow

# Clave interna del webserver de Airflow (cualquier texto largo).
AIRFLOW__WEBSERVER__SECRET_KEY=cambiar_esta_clave_en_produccion

# Clave con la que Airflow cifra las contraseñas de las Connections en su base.
AIRFLOW__CORE__FERNET_KEY=3UbaHoR2539BiUMWJ4uzJKNu2TkWdCUn0ckCMH3krfk=

# Usuario administrador que se crea al iniciar Airflow.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
